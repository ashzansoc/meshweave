# MESHWEAVE configuration
# Copy to .env and fill in. Never commit the real .env.

# --- Vast.ai (required for any experiment that rents a GPU) ---
VAST_API_KEY=

# --- Coordinator ---
MESHWEAVE_COORD_HOST=127.0.0.1
MESHWEAVE_COORD_PORT=8700
MESHWEAVE_COORD_TLS_CERT=
MESHWEAVE_COORD_TLS_KEY=
# Set to false for any non-loopback deployment
MESHWEAVE_COORD_ALLOW_INSECURE_REGISTRATION=false

# --- Agent ---
MESHWEAVE_AGENT_COORDINATOR_URL=https://127.0.0.1:8700
MESHWEAVE_AGENT_NODE_ID=
MESHWEAVE_AGENT_TLS_CERT=
MESHWEAVE_AGENT_TLS_KEY=
MESHWEAVE_AGENT_TLS_CA=
